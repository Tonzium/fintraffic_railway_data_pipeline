# Copy to .env next to docker-compose.demo.yml
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token
CLOUDFLARE_TUNNEL_TOKEN=

# On the server: make plain `docker compose ps/logs/up` use the demo stack
# (docker-compose.yml in the same folder is the local development stack).
COMPOSE_FILE=docker-compose.demo.yml

# Optional overrides
TZ=Europe/Helsinki
UPDATE_HOUR=7
# Days re-fetched and reloaded by each daily run
BACKFILL_DAYS=7
# Days of history kept (raw files and warehouse); older days are deleted
RETENTION_DAYS=365
# A run that takes longer than this is killed and retried at the next schedule
RUN_TIMEOUT=3h
# Node heap for the Evidence build
NODE_OPTIONS=--max-old-space-size=4096
