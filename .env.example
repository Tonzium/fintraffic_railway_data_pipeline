# Copy to .env next to docker-compose.demo.yml
# Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> token
CLOUDFLARE_TUNNEL_TOKEN=

# SERVER ONLY: makes plain `docker compose ps/logs/up` use the demo stack. Leave it
# commented out on a development machine, where docker-compose.yml is the dev stack.
# COMPOSE_FILE=docker-compose.demo.yml

# Optional overrides
TZ=Europe/Helsinki
UPDATE_HOUR=7
# Days re-fetched and reloaded by each daily run
BACKFILL_DAYS=7
# Days of history kept (raw files and warehouse); older days are deleted
RETENTION_DAYS=365
# A run that takes longer than this is stopped and retried at the next schedule
RUN_TIMEOUT=3h
# Node heap for the Evidence build (it needs at least 2048 MB)
NODE_OPTIONS=--max-old-space-size=4096
# DuckDB (dbt) memory cap and threads
DUCKDB_MEMORY_LIMIT=4GB
DUCKDB_THREADS=2
